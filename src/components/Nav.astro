---
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang].nav;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const langLinks: { code: Lang; href: string }[] = [
  { code: 'it', href: `${base}/` },
  { code: 'en', href: `${base}/en/` },
  { code: 'ro', href: `${base}/ro/` },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-line bg-[rgba(3,3,3,0.75)] backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3.5">
    <a href="#hero" class="font-mono text-sm font-bold tracking-widest text-ink">
      <span class="text-acid">▚</span> CP<span class="text-acid">_</span>
    </a>

    <div class="hidden items-center gap-6 font-mono text-xs tracking-wider md:flex">
      <a href="#skills" class="text-dim transition-colors hover:text-acid"><span class="text-dim/60">[01]</span> {t.skills}</a>
      <a href="#esperienza" class="text-dim transition-colors hover:text-cyber"><span class="text-dim/60">[02]</span> {t.exp}</a>
      <a href="#progetti" class="text-dim transition-colors hover:text-vio"><span class="text-dim/60">[03]</span> {t.projects}</a>
      <a href="#contatti" class="text-dim transition-colors hover:text-acid"><span class="text-dim/60">[04]</span> {t.contact}</a>
    </div>

    <div class="flex items-center gap-4">
      <div class="flex items-center gap-1 font-mono text-xs" aria-label="Language">
        {
          langLinks.map((l, i) => (
            <>
              {i > 0 && <span class="text-dim/40">·</span>}
              <a
                href={l.href}
                aria-current={l.code === lang ? 'page' : undefined}
                class={l.code === lang
                  ? 'px-1 font-bold text-acid'
                  : 'px-1 text-dim transition-colors hover:text-ink'}
              >{l.code.toUpperCase()}</a>
            </>
          ))
        }
      </div>
      <a
        href="https://github.com/CristiPerciun"
        target="_blank"
        rel="noopener"
        class="hidden border border-line px-3 py-1.5 font-mono text-xs text-dim transition hover:border-acid hover:text-acid sm:block"
      >github ↗</a>
    </div>
  </div>
</nav>

---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Skills from './Skills.astro';
import Timeline from './Timeline.astro';
import Projects from './Projects.astro';
import Footer from './Footer.astro';
import { translations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const meta = translations[lang].meta;
---

<Layout title={meta.title} description={meta.description} lang={lang}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <Skills lang={lang} />
    <Timeline lang={lang} />
    <Projects lang={lang} />
  </main>
  <Footer lang={lang} />
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    gsap.utils.toArray<HTMLElement>('[data-reveal-stagger]').forEach((grid) => {
      gsap.from(grid.children, {
        y: 36,
        opacity: 0,
        duration: 0.7,
        stagger: 0.08,
        ease: 'power3.out',
        scrollTrigger: { trigger: grid, start: 'top 80%' },
      });
    });

    gsap.utils.toArray<HTMLElement>('.section-tag').forEach((tag) => {
      gsap.from(tag, {
        x: -24,
        opacity: 0,
        duration: 0.6,
        ease: 'power2.out',
        scrollTrigger: { trigger: tag, start: 'top 88%' },
      });
    });
  }
</script>

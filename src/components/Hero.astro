---
import { translations, CV_FILES, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang].hero;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cvUrl = `${base}/cv/${CV_FILES[lang]}`;

const heroData = JSON.stringify({
  roles: t.roles,
  shapeLabels: t.shapeLabels,
  hint: t.hint,
  hintTouch: t.hintTouch,
  hintPrinting: t.hintPrinting,
  hintDone: t.hintDone,
});
---

<section id="hero" class="relative min-h-screen overflow-hidden" data-hero={heroData}>
  <!-- soft glow following the pointer -->
  <div class="torch" aria-hidden="true"></div>

  <div
    class="relative z-10 mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-6 pt-28 pb-16 lg:grid-cols-[1.1fr_1fr] lg:pt-0 lg:min-h-screen"
  >
    <!-- ============ left: copy ============ -->
    <div>
      <p class="font-mono text-xs tracking-[0.3em] text-acid uppercase">
        <span class="text-dim">$</span> boot: perciun_os --profile
      </p>

      <h1 class="mt-5 text-5xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl">
        Cristian<br />Perciun<span class="text-acid">_</span>
      </h1>

      <p class="mt-6 h-8 font-mono text-base text-cyber sm:text-lg">
        <span class="text-dim">&gt;</span>
        <span id="typing"></span><span class="cursor-blink" aria-hidden="true"></span>
      </p>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-dim" set:html={t.blurb} />

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#progetti" class="neon-btn">{t.cta1}</a>
        <a href="#contatti" class="neon-btn neon-btn--cyan">{t.cta2}</a>
      </div>

      <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-4 font-mono text-sm sm:grid-cols-4">
        <div>
          <dt class="text-[10px] tracking-widest text-dim uppercase">{t.stats[0]}</dt>
          <dd class="mt-1 text-2xl font-bold text-acid">7+</dd>
        </div>
        <div>
          <dt class="text-[10px] tracking-widest text-dim uppercase">{t.stats[1]}</dt>
          <dd class="mt-1 text-2xl font-bold text-cyber">6</dd>
        </div>
        <div>
          <dt class="text-[10px] tracking-widest text-dim uppercase">{t.stats[2]}</dt>
          <dd class="mt-1 text-2xl font-bold text-vio">4</dd>
        </div>
        <div>
          <dt class="text-[10px] tracking-widest text-dim uppercase">{t.stats[3]}</dt>
          <dd class="mt-1 text-2xl font-bold text-ink">3</dd>
        </div>
      </dl>
    </div>

    <!-- ============ right: particle hologram ============ -->
    <div class="relative mx-auto w-full max-w-[460px]">
      <div id="stage" class="relative w-full select-none" style="aspect-ratio: 600 / 700;">
        <canvas id="holo" class="absolute inset-0 h-full w-full"></canvas>

        <!-- hotspot pings -->
        <div class="hotspot" data-hs="0" style="left: 50%; top: 13.4%;"><span class="ring"></span></div>
        <div class="hotspot" data-hs="1" style="left: 24.8%; top: 66.4%;"><span class="ring"></span></div>
        <div class="hotspot" data-hs="2" style="left: 50%; top: 84.3%;"><span class="ring"></span></div>

        <!-- CV download, unlocked by the hotspots -->
        <a
          id="cv-unlock"
          href={cvUrl}
          download
          class="absolute bottom-[3%] left-1/2 z-30 -translate-x-1/2 border border-acid bg-[rgba(3,3,3,0.85)] px-6 py-2.5 text-center font-mono text-[13px] font-bold tracking-widest whitespace-nowrap text-acid backdrop-blur-sm transition hover:bg-acid hover:text-black"
        >{t.cvBtn}</a>
      </div>

      <!-- hint + progress + shape label -->
      <p class="mt-4 text-center font-mono text-[11px] tracking-widest text-dim">
        <span id="hs-hint">{t.hint}</span>
        <span id="hs-count" class="ml-2 text-acid">[0/3]</span>
      </p>
      <p class="mt-1 text-center font-mono text-[10px] tracking-[0.3em] text-dim/60">
        [ HOLOGRAM: <span id="shape-label" class="text-cyber">{t.shapeLabels[0]}</span> ]
      </p>
    </div>
  </div>
</section>

<style>
  .torch {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    opacity: var(--torch-o, 0);
    transition: opacity 0.4s;
    background: radial-gradient(
      circle 280px at var(--lx, 50%) var(--ly, 50%),
      rgba(0, 229, 255, 0.1) 0%,
      rgba(139, 92, 246, 0.06) 40%,
      transparent 70%
    );
  }

  /* --- hotspots --- */
  .hotspot {
    position: absolute;
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    pointer-events: none;
    z-index: 20;
  }

  .hotspot .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid var(--color-acid);
    opacity: 0;
    transform: scale(0.4);
  }

  .hotspot.found .ring {
    opacity: 1;
    animation: hs-ping 1.4s ease-out infinite;
  }

  @keyframes hs-ping {
    0% { transform: scale(0.4); opacity: 1; }
    100% { transform: scale(2.6); opacity: 0; }
  }

  /* --- CV unlock button --- */
  #cv-unlock {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  #cv-unlock.unlocked {
    visibility: visible;
    pointer-events: auto;
    animation: glitch-in 0.7s steps(12) forwards;
    box-shadow:
      0 0 24px rgba(163, 255, 18, 0.35),
      inset 0 0 16px rgba(163, 255, 18, 0.08);
  }

  @keyframes glitch-in {
    0% { opacity: 0; transform: translate(-52%, 6px) skewX(-8deg); }
    20% { opacity: 1; transform: translate(-49%, -2px) skewX(6deg); }
    40% { opacity: 0.4; transform: translate(-51%, 1px) skewX(-4deg); }
    60% { opacity: 1; transform: translate(-50%, 0) skewX(2deg); }
    80% { opacity: 0.7; transform: translate(-50%, 0) skewX(0); }
    100% { opacity: 1; transform: translate(-50%, 0); }
  }
</style>

<script>
  const hero = document.getElementById('hero')!;
  const CFG = JSON.parse(hero.dataset.hero!);
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- typing effect ----------
  const typingEl = document.getElementById('typing')!;
  const roles: string[] = CFG.roles;

  if (reduced) {
    typingEl.textContent = roles[0];
  } else {
    let ri = 0, ci = 0, deleting = false;
    const tick = () => {
      const word = roles[ri];
      typingEl.textContent = word.slice(0, ci);
      let delay = deleting ? 34 : 72;
      if (!deleting && ci === word.length) {
        deleting = true;
        delay = 1800;
      } else if (deleting && ci === 0) {
        deleting = false;
        ri = (ri + 1) % roles.length;
        delay = 420;
      } else {
        ci += deleting ? -1 : 1;
      }
      setTimeout(tick, delay);
    };
    tick();
  }

  // ---------- particle hologram ----------
  const stage = document.getElementById('stage')!;
  const canvas = document.getElementById('holo') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const touchMode = window.matchMedia('(hover: none)').matches;

  const countEl = document.getElementById('hs-count')!;
  const hintEl = document.getElementById('hs-hint')!;
  const shapeEl = document.getElementById('shape-label')!;
  const cvBtn = document.getElementById('cv-unlock')!;

  if (touchMode) hintEl.textContent = CFG.hintTouch;

  // --- shape targets sampled from an offscreen 600x700 canvas ---
  const VW = 600, VH = 700;
  const off = document.createElement('canvas');
  off.width = VW;
  off.height = VH;
  const octx = off.getContext('2d', { willReadFrequently: true })!;

  const rr = (x: number, y: number, w: number, h: number, r: number) => {
    octx.beginPath();
    octx.roundRect(x, y, w, h, r);
  };

  const drawShape = (name: string) => {
    octx.clearRect(0, 0, VW, VH);
    octx.fillStyle = '#fff';
    octx.strokeStyle = '#fff';

    if (name === 'pos') {
      octx.lineWidth = 12;
      rr(160, 110, 280, 440, 26); octx.stroke();          // body
      rr(278, 78, 44, 32, 6); octx.stroke();               // antenna
      octx.lineWidth = 8;
      rr(195, 150, 210, 130, 10); octx.stroke();           // screen
      for (let r = 0; r < 3; r++)
        for (let c = 0; c < 3; c++) { rr(200 + c * 72, 320 + r * 56, 56, 40, 6); octx.fill(); } // keys
      rr(230, 585, 140, 10, 5); octx.fill();               // slot
      for (const y of [150, 190, 230, 270, 390, 430, 470, 510]) {
        octx.fillRect(130, y, 30, 10);                     // pins
        octx.fillRect(440, y, 30, 10);
      }
    } else if (name === 'code') {
      octx.font = '900 300px "JetBrains Mono Variable", monospace';
      octx.textAlign = 'center';
      octx.textBaseline = 'middle';
      octx.fillText('</>', VW / 2, VH / 2 - 20);
    } else if (name === 'euro') {
      octx.font = '900 440px "Plus Jakarta Sans Variable", sans-serif';
      octx.textAlign = 'center';
      octx.textBaseline = 'middle';
      octx.fillText('€', VW / 2, VH / 2 - 10);
    } else if (name === 'ai') {
      octx.font = '900 260px "JetBrains Mono Variable", monospace';
      octx.textAlign = 'center';
      octx.textBaseline = 'middle';
      octx.fillText('AI', VW / 2, VH / 2 - 90);
      octx.lineWidth = 14;
      octx.beginPath();
      octx.arc(VW / 2, VH / 2 - 60, 250, 0, Math.PI * 2); // orbit ring
      octx.stroke();
      octx.font = '700 90px "JetBrains Mono Variable", monospace';
      octx.fillText('{ } ', VW / 2, VH / 2 + 130);
    } else {
      // 'cv' — secret shape unlocked by the hotspots
      octx.font = '900 280px "JetBrains Mono Variable", monospace';
      octx.textAlign = 'center';
      octx.textBaseline = 'middle';
      octx.fillText('CV', VW / 2, VH / 2 - 130);
      // down arrow
      octx.fillRect(VW / 2 - 32, VH / 2 + 40, 64, 130);
      octx.beginPath();
      octx.moveTo(VW / 2 - 95, VH / 2 + 170);
      octx.lineTo(VW / 2 + 95, VH / 2 + 170);
      octx.lineTo(VW / 2, VH / 2 + 290);
      octx.closePath();
      octx.fill();
    }

    const img = octx.getImageData(0, 0, VW, VH).data;
    const pts: { x: number; y: number }[] = [];
    const STEP = 6;
    for (let y = 0; y < VH; y += STEP)
      for (let x = 0; x < VW; x += STEP)
        if (img[(y * VW + x) * 4 + 3] > 128) pts.push({ x, y });
    // shuffle for a nice swirl on morph
    for (let i = pts.length - 1; i > 0; i--) {
      const j = (i * 16807 + 11) % (i + 1); // deterministic shuffle
      [pts[i], pts[j]] = [pts[j], pts[i]];
    }
    return pts;
  };

  const SHAPES = ['pos', 'code', 'euro', 'ai', 'cv'];
  const CV_IDX = 4; // secret: excluded from auto-rotation until unlocked
  let rotationLen = CV_IDX;
  const shapePts = SHAPES.map(drawShape);

  // --- particles ---
  const N = 2400;
  const COLORS = ['#00e5ff', '#00e5ff', '#00e5ff', '#a3ff12', '#a3ff12', '#8b5cf6'];
  type P = { x: number; y: number; vx: number; vy: number; tx: number; ty: number; c: string; sz: number };
  const parts: P[] = [];
  for (let i = 0; i < N; i++) {
    parts.push({
      x: Math.random() * VW, y: Math.random() * VH,
      vx: 0, vy: 0, tx: 0, ty: 0,
      c: COLORS[i % COLORS.length],
      sz: 1.4 + (i % 5) * 0.35,
    });
  }

  let shapeIdx = 0;
  const assign = (idx: number) => {
    const pts = shapePts[idx];
    for (let i = 0; i < N; i++) {
      const p = pts[i % pts.length];
      parts[i].tx = p.x;
      parts[i].ty = p.y;
    }
    shapeEl.textContent = CFG.shapeLabels[idx];
  };
  assign(0);

  // --- sizing ---
  let W = 0, H = 0, scale = 1, ox = 0, oy = 0;
  const resize = () => {
    const r = stage.getBoundingClientRect();
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    W = r.width; H = r.height;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    scale = Math.min(W / VW, H / VH);
    ox = (W - VW * scale) / 2;
    oy = (H - VH * scale) / 2;
  };
  resize();
  window.addEventListener('resize', resize);

  // --- pointer / torch ---
  let mx = -9999, my = -9999;      // pointer in stage px
  let heroX = 0.5, heroY = 0.5;    // pointer fraction in hero (for torch glow)
  let pointerIn = false;

  hero.addEventListener('pointermove', (e) => {
    const hr = hero.getBoundingClientRect();
    heroX = (e.clientX - hr.left) / hr.width;
    heroY = (e.clientY - hr.top) / hr.height;
    const sr = stage.getBoundingClientRect();
    mx = e.clientX - sr.left;
    my = e.clientY - sr.top;
    pointerIn = true;
    hero.style.setProperty('--lx', `${(heroX * 100).toFixed(2)}%`);
    hero.style.setProperty('--ly', `${(heroY * 100).toFixed(2)}%`);
    hero.style.setProperty('--torch-o', '1');
  });
  hero.addEventListener('pointerleave', () => {
    pointerIn = false;
    mx = my = -9999;
    hero.style.setProperty('--torch-o', '0');
  });

  // shockwave on click/tap
  const waves: { x: number; y: number; r: number; a: number }[] = [];
  stage.addEventListener('pointerdown', (e) => {
    const sr = stage.getBoundingClientRect();
    const cx = e.clientX - sr.left;
    const cy = e.clientY - sr.top;
    mx = cx; my = cy;
    waves.push({ x: cx, y: cy, r: 4, a: 0.9 });
    for (const p of parts) {
      const px = ox + p.tx * scale, py = oy + p.ty * scale;
      const dx = p.x - cx, dy = p.y - cy;
      const d = Math.hypot(dx, dy) || 1;
      const f = 9 * Math.exp(-d / 130);
      p.vx += (dx / d) * f;
      p.vy += (dy / d) * f;
      void px; void py;
    }
  });

  // --- hotspots / receipt easter egg ---
  const HOTSPOTS = [
    { x: 0.5, y: 0.134 },
    { x: 0.248, y: 0.664 },
    { x: 0.5, y: 0.843 },
  ];
  const found = [false, false, false];
  const dwell = [0, 0, 0];
  let unlocked = false;

  const unlock = () => {
    if (unlocked) return;
    unlocked = true;
    hintEl.textContent = CFG.hintPrinting;
    stage.animate(
      [
        { filter: 'brightness(1)' },
        { filter: 'brightness(2.2) hue-rotate(40deg)' },
        { filter: 'brightness(0.6)' },
        { filter: 'brightness(1)' },
      ],
      { duration: 260, iterations: 2 }
    );
    // big shockwave from the center, then morph into the secret CV shape
    waves.push({ x: W / 2, y: H / 2, r: 4, a: 1 });
    setTimeout(() => {
      shapeIdx = CV_IDX;
      assign(CV_IDX);
      rotationLen = SHAPES.length; // CV joins the rotation from now on
      morphAt = performance.now() + 9000; // linger on the reward
      cvBtn.classList.add('unlocked');
      hintEl.textContent = CFG.hintDone;
    }, 600);
  };

  const markFound = (i: number) => {
    if (found[i]) return;
    found[i] = true;
    document.querySelector<HTMLElement>(`.hotspot[data-hs="${i}"]`)?.classList.add('found');
    // particle burst around the hotspot
    const hx = HOTSPOTS[i].x * W, hy = HOTSPOTS[i].y * H;
    waves.push({ x: hx, y: hy, r: 4, a: 1 });
    for (const p of parts) {
      const dx = p.x - hx, dy = p.y - hy;
      const d = Math.hypot(dx, dy) || 1;
      if (d < 120) {
        p.vx += (dx / d) * 7;
        p.vy += (dy / d) * 7;
      }
    }
    const n = found.filter(Boolean).length;
    countEl.textContent = `[${n}/3]`;
    if (n === 3) unlock();
  };

  // --- main loop ---
  let running = true;
  let last = performance.now();
  let morphAt = last + 5200;

  const frame = (now: number) => {
    if (!running) return;
    const dt = Math.min(64, now - last);
    last = now;

    if (now > morphAt) {
      shapeIdx = (shapeIdx + 1) % rotationLen;
      assign(shapeIdx);
      morphAt = now + 5200;
    }

    // motion-trail fade
    ctx.globalCompositeOperation = 'source-over';
    ctx.fillStyle = 'rgba(3, 3, 3, 0.3)';
    ctx.fillRect(0, 0, W, H);

    ctx.globalCompositeOperation = 'lighter';
    const k = dt / 16.67;
    for (const p of parts) {
      const sx = ox + p.tx * scale;
      const sy = oy + p.ty * scale;
      let ax = (sx - p.x) * 0.014;
      let ay = (sy - p.y) * 0.014;

      // pointer repulsion — the fun part
      const dx = p.x - mx, dy = p.y - my;
      const d = Math.hypot(dx, dy);
      if (d < 110 && d > 0.01) {
        const f = ((110 - d) / 110) * 1.9;
        ax += (dx / d) * f;
        ay += (dy / d) * f;
      }

      p.vx = (p.vx + ax * k) * 0.9;
      p.vy = (p.vy + ay * k) * 0.9;
      p.x += p.vx * k;
      p.y += p.vy * k;

      ctx.fillStyle = p.c;
      ctx.fillRect(p.x, p.y, p.sz, p.sz);
    }

    // shockwave rings
    ctx.globalCompositeOperation = 'source-over';
    for (let i = waves.length - 1; i >= 0; i--) {
      const w = waves[i];
      w.r += 7 * k;
      w.a -= 0.03 * k;
      if (w.a <= 0) { waves.splice(i, 1); continue; }
      ctx.strokeStyle = `rgba(0, 229, 255, ${w.a.toFixed(3)})`;
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(w.x, w.y, w.r, 0, Math.PI * 2);
      ctx.stroke();
    }

    // undiscovered hotspots: faint flicker to attract the eye
    if (!unlocked) {
      for (let i = 0; i < HOTSPOTS.length; i++) {
        if (found[i]) continue;
        const hx = HOTSPOTS[i].x * W, hy = HOTSPOTS[i].y * H;
        const tw = 0.25 + 0.2 * Math.sin(now / 300 + i * 2.1);
        ctx.fillStyle = `rgba(163, 255, 18, ${tw.toFixed(3)})`;
        ctx.beginPath();
        ctx.arc(hx, hy, 3, 0, Math.PI * 2);
        ctx.fill();

        // dwell detection
        if (pointerIn || touchMode) {
          const dd = Math.hypot(mx - hx, my - hy);
          if (dd < 70) {
            dwell[i] += dt;
            if (dwell[i] > 350) markFound(i);
          } else {
            dwell[i] = 0;
          }
        }
      }
    }

    requestAnimationFrame(frame);
  };

  if (reduced) {
    // static render at targets, CV immediately available
    ctx.fillStyle = '#030303';
    ctx.fillRect(0, 0, W, H);
    for (const p of parts) {
      ctx.fillStyle = p.c;
      ctx.fillRect(ox + p.tx * scale, oy + p.ty * scale, p.sz, p.sz);
    }
    cvBtn.classList.add('unlocked');
    hintEl.textContent = CFG.hintDone;
    countEl.textContent = '[3/3]';
  } else {
    // pause when offscreen or tab hidden
    const io = new IntersectionObserver((entries) => {
      const visible = entries[0].isIntersecting;
      if (visible && !running) {
        running = true;
        last = performance.now();
        morphAt = last + 5200;
        requestAnimationFrame(frame);
      } else if (!visible) {
        running = false;
      }
    });
    io.observe(stage);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        running = false;
      } else if (!running) {
        running = true;
        last = performance.now();
        requestAnimationFrame(frame);
      }
    });
    requestAnimationFrame(frame);
  }
</script>

---
import { translations, JOB_META, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang].timeline;
const jobs = t.jobs.map((j, i) => ({ ...j, ...JOB_META[i] }));
---

<section id="esperienza" class="relative mx-auto max-w-4xl px-6 py-28">
  <p class="section-tag">changelog</p>
  <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-5xl">
    {t.heading}<span class="text-acid">.</span>
  </h2>

  <div class="relative mt-16 pl-8 sm:pl-12">
    <!-- track + progress line -->
    <div class="absolute top-0 bottom-0 left-[7px] w-px bg-line sm:left-[11px]" aria-hidden="true"></div>
    <div id="tl-progress" class="absolute top-0 left-[7px] w-px origin-top bg-gradient-to-b from-acid via-cyber to-vio sm:left-[11px]" style="height: 100%; transform: scaleY(0); box-shadow: 0 0 12px rgba(0,229,255,0.5);" aria-hidden="true"></div>

    <ol class="space-y-16">
      {
        jobs.map((j) => (
          <li class="tl-item relative">
            <span class={`tl-dot tl-dot--${j.accent}`} aria-hidden="true" />
            <p class="font-mono text-xs tracking-[0.2em] text-dim">{j.period}</p>
            <h3 class="mt-2 text-xl font-bold sm:text-2xl">{j.role}</h3>
            <p class="mt-1 font-mono text-sm text-cyber">{j.company}</p>
            <ul class="mt-4 space-y-2.5">
              {j.points.map((p) => (
                <li class="flex gap-3 text-sm leading-relaxed text-dim">
                  <span class="mt-0.5 font-mono text-acid">▹</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .tl-dot {
    position: absolute;
    left: -33px;
    top: 4px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: var(--color-void);
    border: 2px solid var(--color-dim);
  }

  @media (min-width: 640px) {
    .tl-dot { left: -37px; }
  }

  .tl-dot--acid { border-color: var(--color-acid); box-shadow: 0 0 10px rgba(163, 255, 18, 0.6); }
  .tl-dot--cyan { border-color: var(--color-cyber); box-shadow: 0 0 10px rgba(0, 229, 255, 0.6); }
  .tl-dot--vio { border-color: var(--color-vio); box-shadow: 0 0 10px rgba(139, 92, 246, 0.6); }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    gsap.to('#tl-progress', {
      scaleY: 1,
      ease: 'none',
      scrollTrigger: {
        trigger: '#esperienza',
        start: 'top 60%',
        end: 'bottom 70%',
        scrub: 0.6,
      },
    });

    gsap.utils.toArray<HTMLElement>('.tl-item').forEach((item) => {
      gsap.from(item, {
        y: 48,
        opacity: 0,
        duration: 0.9,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: item,
          start: 'top 82%',
        },
      });
    });
  } else {
    const p = document.getElementById('tl-progress');
    if (p) p.style.transform = 'scaleY(1)';
  }
</script>

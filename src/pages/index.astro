---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import Timeline from '../components/Timeline.astro';
import Projects from '../components/Projects.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Cristian Perciun — Senior Flutter / Full-Stack Developer">
  <Nav />
  <main>
    <Hero />
    <Skills />
    <Timeline />
    <Projects />
  </main>
  <Footer />
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduced) {
    // generic reveal: sections fade/slide in; bento cells stagger
    gsap.utils.toArray<HTMLElement>('[data-reveal-stagger]').forEach((grid) => {
      gsap.from(grid.children, {
        y: 36,
        opacity: 0,
        duration: 0.7,
        stagger: 0.08,
        ease: 'power3.out',
        scrollTrigger: { trigger: grid, start: 'top 80%' },
      });
    });

    gsap.utils.toArray<HTMLElement>('.section-tag').forEach((tag) => {
      gsap.from(tag, {
        x: -24,
        opacity: 0,
        duration: 0.6,
        ease: 'power2.out',
        scrollTrigger: { trigger: tag, start: 'top 88%' },
      });
    });
  }
</script>
